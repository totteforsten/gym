# ─────────────────────────────────────────────────────────────
# Atlas Gym — environment variables
# Copy this file to `.env` and fill in your database URL.
# ─────────────────────────────────────────────────────────────

# Postgres connection string. Works with Vercel Postgres, Neon,
# Supabase, Railway, or a local Postgres instance.
#
# Neon (free):     https://neon.tech  → copy the connection string
# Vercel Postgres: Storage tab → .env.local tab → POSTGRES_URL
#
# Runtime connection. With the Neon + Vercel integration this is set for you
# (the pooled connection). For a manual setup, a single direct connection URL
# works fine. Example:
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (non-pooled) connection used by `prisma db push` for schema changes.
# The Neon Vercel integration sets this automatically. If you only have one
# URL, you can leave this unset — the Vercel build falls back to DATABASE_URL,
# and locally you can set it to the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign login session cookies. Set this to a long random string
# in production (e.g. run: `openssl rand -base64 32`). If unset, a insecure
# development fallback is used so local runs still work.
AUTH_SECRET="change-me-to-a-long-random-string"
